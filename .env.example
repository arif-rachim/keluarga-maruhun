# Integrasi cloud Manggaleh (opsional).
# Salin file ini ke `.env.local` (sudah di-ignore git) lalu isi nilainya.
# Biarkan kosong / tidak ada file = aplikasi memakai localStorage seperti biasa.
#
# PENTING: hanya PUBLISHABLE key (mgpk_...) yang boleh ada di sini — aman untuk
# browser. JANGAN pernah menaruh SERVICE key di file front-end mana pun.

VITE_MANGGALEH_BASE_URL=https://api.manggaleh.com
VITE_MANGGALEH_TENANT=your-project-slug
VITE_MANGGALEH_ENV=dev
VITE_MANGGALEH_KEY=mgpk_xxx
VITE_MANGGALEH_COLLECTION=people

# Set true SEKALI saja pada run pertama untuk mengisi data awal (seed) ke
# proyek yang masih kosong. Setelah terisi, kembalikan ke false.
VITE_MANGGALEH_SEED=false

# Gerbang sunting (whitelist nomor telepon) otomatis aktif saat env di atas
# terisi — lihat docs/MANGGALEH_WHITELIST.md.
#
# SERVICE key (mgsk_...) HANYA untuk mengelola whitelist lewat skrip lokal
# (scripts/manggaleh-whitelist.mjs). JANGAN beri prefix VITE_ (akan ikut ke
# bundle) dan JANGAN di-commit. Berikan lewat env saat menjalankan skrip, mis.:
#   MANGGALEH_SERVICE_KEY=mgsk_xxx node --env-file=.env.local scripts/manggaleh-whitelist.mjs list
